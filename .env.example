# Server Configuration
PORT=3000

# Choose your AI Provider:
# NOTE: Put your actual secret keys in 'api.env' (which is git-ignored).
# NEVER commit your real API keys to GitHub!
# -------------------------------------------------------------
# 1. OpenAI API Key (GPT-4o, GPT-4o-mini)
# Get your key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# 2. Google Gemini API Key (Gemini 2.0 Flash / 1.5 Flash)
# Get your key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# 3. Groq API Key (Free, high-speed LLM)
# Get your key at: https://console.groq.com/keys
GROQ_API_KEY=
